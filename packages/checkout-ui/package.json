    "./components/PaymentPage.vue": "./src/components/PaymentPage.vue",
    "./components/PlanLine.vue": "./src/components/PlanLine.vue",
    "./components/PlanOptions.vue": "./src/components/PlanOptions.vue",
    "./components/PolicyConsent.vue": "./src/components/PolicyConsent.vue",
