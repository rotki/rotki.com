{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "compilerOptions": {
    "types": ["node"],
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "vueCompilerOptions": {
    "fallthroughAttributes": true,
    "strictTemplates": true
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "vitest.config.ts"]
}
